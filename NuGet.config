<?xml version="1.0" encoding="utf-8"?>
<!--
  刻意不联网：本工程只引用 GAC 里的 System.* 程序集和本机已装的 .NET Framework 4.7.2
  引用程序集，不需要任何 NuGet 包。清空 packageSources 让 restore 完全离线，
  顺便避免在受限环境里因为读 %APPDATA%\NuGet\NuGet.Config 而失败。
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
